PORT=4000
TRUST_PROXY=false

# Rate limiting
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_REFRESH_WINDOW_MS=900000
RATE_LIMIT_AUTH_REFRESH_MAX=30
RATE_LIMIT_USER_WINDOW_MS=60000
RATE_LIMIT_USER_MAX=30
RATE_LIMIT_DISPUTE_WINDOW_MS=3600000
RATE_LIMIT_DISPUTE_MAX=5
NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/grayfix
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=your-super-secret-jwt-key-must-be-at-least-32-chars-change-in-production!
JWT_EXPIRES_IN=86400
JWT_ISSUER=grayfix
JWT_AUDIENCE=grayfix-api
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=
# API_PUBLIC_URL=https://api.example.com  # optional; must be a valid URL if set (empty string fails validation)

# Stellar / Soroban
STELLAR_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE=
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_RPC_URL=
# CONTRACT_ID=  # deprecated alias for GRAYFIX_ESCROW_CONTRACT_ID; leave unset (empty string fails validation)
GRAYFIX_ESCROW_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
USDC_CONTRACT_ID=CYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYY
ADMIN_STELLAR_PUBKEYS=

# Pinata / IPFS
PINATA_API_KEY=
PINATA_SECRET=
PINATA_JWT=
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
IPFS_GATEWAY_URLS=
IPFS_GATEWAY_ALLOWLIST=
IPFS_UPLOAD_TIMEOUT_MS=10000
IPFS_STREAM_TIMEOUT_MS=5000
IPFS_PINATA_CIRCUIT_FAILURE_THRESHOLD=3
IPFS_PINATA_CIRCUIT_COOLDOWN_MS=30000
IPFS_GATEWAY_CIRCUIT_FAILURE_THRESHOLD=3
IPFS_GATEWAY_CIRCUIT_COOLDOWN_MS=30000
# Private/signature-aware IPFS gateway settings for dispute-evidence downloads
# IPFS_URL_SIGNING_SECRET=  # optional; must be 32+ chars if set (empty string fails validation)
IPFS_URL_TTL_SECONDS=300

# Evidence / manifest
EVIDENCE_MAX_BYTES=52428800
EVIDENCE_METADATA_RETENTION_DAYS=90
EVIDENCE_SCAN_REQUIRED=false
EVIDENCE_PIN_VERIFICATION_BATCH_SIZE=50
EVIDENCE_PIN_VERIFICATION_INTERVAL_MS=3600000
MANIFEST_PII_RETENTION_DAYS=30

# Soroban event listener
EVENT_POLL_INTERVAL_MS=10000
BACKOFF_INITIAL_MS=1000
BACKOFF_MAX_MS=30000
PROCESSED_LEDGERS_CACHE_SIZE=10000
EVENT_OUTBOX_MAX_ATTEMPTS=5

# Distributed tracing (optional)
JAEGER_ENDPOINT=
ZIPKIN_ENDPOINT=
PROMETHEUS_PORT=
OTEL_SERVICE_NAME=
OTEL_EXPORTER_JAEGER_AGENT_HOST=
OTEL_EXPORTER_JAEGER_AGENT_PORT=

# Audit export signing (Ed25519 PEM keys)
AUDIT_SIGNING_KEY_ID=grayfix-audit-key-v1
# AUDIT_SIGNING_PRIVATE_KEY_PEM=  # optional; empty string fails validation if uncommented
# AUDIT_SIGNING_PUBLIC_KEY_PEM=   # optional; empty string fails validation if uncommented

# Webhooks (optional)
# WEBHOOK_URL=  # must be a valid URL if set (empty string fails validation)
WEBHOOK_SECRET=

# Ops alert webhook (cache/DB failures; separate from trade webhooks)
# ALERT_WEBHOOK_URL=  # must be a valid URL if set (empty string fails validation)
ALERT_WEBHOOK_SECRET=
ALERT_COOLDOWN_MS=300000

# Trust Score configuration
TRUST_SCORE_DECAY_HALF_LIFE_DAYS=90
TRUST_SCORE_RECALCULATION_INTERVAL_MS=3600000

# Trade notes encryption (AES-256-GCM) — dedicated key, NOT derived from JWT_SECRET.
# envValidator.ts treats this as CRITICAL (app won't start without it) even
# though env.ts's schema marks it optional — it must be present, 32+ chars.
# This is an obviously-fake placeholder; generate your own with:
#   openssl rand -base64 32
TRADE_NOTES_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32
